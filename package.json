{
  "name": "claude-playwright-browser",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright browser tools and setup instructions for Claude Code",
  "scripts": {
    "setup": "npm ci && playwright install chromium",
    "setup:linux": "npm ci && playwright install --with-deps chromium",
    "mcp": "playwright-mcp --config playwright-mcp.config.json"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "@playwright/mcp": "0.0.84" }
}
